// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Poem {
    id        String   @id @default(cuid())
    title     String
    version   String // "junior" or "senior"
    tags      String[]
    author    String?
    dynasty   String?
    mode      String // "poem" or "paragraph"
    content   String
    starredBy       Star[]
    sentenceStarredBy SentenceStar[]
    dictationMistakes DictationMistake[]
    dictationReviewStates DictationReviewState[]
    perfectDictationAnswers PerfectDictationAnswer[]

    @@map("poems")
    @@unique(name: "compoundId",[version, title])
}

model User {
    id       Int             @id
    star     Star[]
    sentenceStars SentenceStar[]
    checkIns CheckIn[]
    dictationMistakes DictationMistake[]
    perfectDictationSetting PerfectDictationSetting?
    dictationReviewStates DictationReviewState[]
    perfectDictationGroups PerfectDictationGroup[]
    perfectDictationAnswers PerfectDictationAnswer[]

    @@map("users")
}

model CheckIn {
    id      String   @id @default(cuid())
    user    User     @relation(fields: [userId], references: [id])
    userId  Int
    date    DateTime @default(now())
    quote   Quote    @relation(fields: [quoteId], references: [id])
    quoteId String

    @@unique([userId, date])
    @@index([userId])
    @@index([date])
    @@map("check_ins")
}

model Star {
    id     Int    @id @default(autoincrement())
    user   User   @relation(fields: [userId], references: [id])
    userId Int
    poem   Poem   @relation(fields: [poemId], references: [id])
    poemId String

    @@map("stars")
    @@unique(name: "compoundId",[userId, poemId])
    @@index([userId])
    @@index([poemId])
    @@index([userId,poemId])
}

model SentenceStar {
    id         Int      @id @default(autoincrement())
    user       User     @relation(fields: [userId], references: [id])
    userId     Int
    poem       Poem     @relation(fields: [poemId], references: [id])
    poemId     String
    text       String
    charOffset Int      @default(0)
    createdAt  DateTime @default(now())

    @@map("sentence_stars")
    @@unique([userId, poemId, text, charOffset])
    @@index([userId])
    @@index([poemId])
}

// 默写错题本：用户从站内古诗文中挑出的完整句子
model DictationMistake {
    id         Int      @id @default(autoincrement())
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId     Int
    poem       Poem     @relation(fields: [poemId], references: [id], onDelete: Cascade)
    poemId     String
    text       String // 展示用规范句（取自诗文原文，带标点）
    normalized String // 去标点后的句子，用于查重
    createdAt  DateTime @default(now())

    @@unique([userId, normalized])
    @@index([userId])
    @@index([poemId])
    @@map("dictation_mistakes")
}

model Author {
    id      String   @id @default(cuid())
    name    String   @unique
    dynasty String?
    epithet String?
    quote   String?
    avatar  String?
    intro   String?
    tags    String[]

    @@map("authors")
}

model Article {
    id       String   @id @default(cuid())
    title    String   @unique
    author   String?
    dynasty  String?
    views    Int      @default(0)
    abstract String?
    content  String?
    img      String?
    tags     String[]

    @@map("articles")
}

model Quote {
    id       String    @id @default(cuid())
    title    String
    quote    String
    author   String
    dynasty  String?
    checkIns CheckIn[]

    @@map("quotes")
}

model Event {
    id         String  @id @default(cuid())
    year       Int
    month      Int
    day        Int
    type       String // "event", "birth", or "death"
    figure     String?
    importance Int     @default(0)
    data       String

    @@map("events")
}

// 默写真题句（scripts/dictation/dictations_annotated.json 导入）
model Dictation {
    id          Int      @id // 沿用标注数据的原始 id
    content     String // 试卷上的默写原句
    revised     String? // 修订后的正确句子（与原文一致时为空）
    sourceType  String // "db" | "db-revised" | "ai" | "none"
    note        String?
    title       String? // 出处篇名（标注结果）
    author      String?
    dynasty     String?
    poemTitle   String? // 数据库中的篇名（可跳转时）
    poemVersion String? // 跳转版本，多版本时优先 senior
    appearances DictationAppearance[]

    @@index([sourceType])
    @@map("dictations")
}

// 默写句的考察记录（试卷信息，从 dictations_full.json 的 path 解析）
model DictationAppearance {
    id          Int        @id @default(autoincrement())
    dictation   Dictation  @relation(fields: [dictationId], references: [id], onDelete: Cascade)
    dictationId Int
    category    String // "真题" | "一模" | "二模" | "上期末" | "下期末"
    grade       String // "高一" | "高二" | "高三"（真题/一模/二模均属高三，期末按卷名）
    year        Int
    region      String // "北京" | "全国" | "天津" | "上海" | "江苏" | "海南" | "其他" ...
    paper       String // 卷名，如 "2022全国甲卷高考真题语文（教师版）"

    @@index([dictationId])
    @@index([year])
    @@index([region])
    @@map("dictation_appearances")
}

// 完胜默写：每日打卡设置
model PerfectDictationSetting {
    id         Int      @id @default(autoincrement())
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId     Int      @unique
    dailyCount Int      @default(10) // 每组题目数量
    mode       String   @default("mixed") // mistakes | new | mixed
    books      String[] @default([]) // 用户自选册次（必修上/选必中…）；空数组 = 跟随年级默认
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@map("perfect_dictation_settings")
}

// 完胜默写：句子的遗忘曲线复习状态（按用户 + 去标点句子唯一）
model DictationReviewState {
    id             Int       @id @default(autoincrement())
    user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId         Int
    poem           Poem      @relation(fields: [poemId], references: [id], onDelete: Cascade)
    poemId         String
    text           String
    normalized     String
    status         String    @default("active") // active | excluded（太简单，不再考察）
    repetitions    Int       @default(0)
    intervalDays   Int       @default(0)
    easeFactor     Float     @default(2.5)
    lapses         Int       @default(0)
    dueAt          DateTime  @default(now())
    lastReviewedAt DateTime?
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt

    @@unique([userId, normalized])
    @@index([userId, status, dueAt])
    @@map("dictation_review_states")
}

// 完胜默写：完成的一组题目（一天可以完成多组）
model PerfectDictationGroup {
    id        String                   @id @default(cuid())
    user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    Int
    day       String // Asia/Shanghai 的 YYYY-MM-DD
    mode      String
    total     Int
    correct   Int
    wrong     Int
    notYet    Int
    tooEasy   Int
    createdAt DateTime                 @default(now())
    answers   PerfectDictationAnswer[]

    @@index([userId, day])
    @@index([userId, createdAt])
    @@map("perfect_dictation_groups")
}

// 完胜默写：每道题的作答记录
model PerfectDictationAnswer {
    id         Int                   @id @default(autoincrement())
    group      PerfectDictationGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
    groupId    String
    user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId     Int
    poem       Poem                  @relation(fields: [poemId], references: [id], onDelete: Cascade)
    poemId     String
    text       String
    normalized String
    pool       String // mistake | new
    result     String // correct | wrong | not_yet | too_easy
    createdAt  DateTime              @default(now())

    @@index([groupId])
    @@index([userId, normalized])
    @@index([userId, createdAt])
    @@map("perfect_dictation_answers")
}
