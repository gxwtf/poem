          ],
          "translation": "出征时就没打算活着回来，平原辽阔迷蒙啊道路遥远漫长。",
          "pinyin": "chū bù rù xī wǎng bù fǎn ， píng yuán hū xī lù chāo yuǎn 。",
          "notes": [
            {
              "start": 2,
              "end": 2,
              "content": "入：归来；‘出不入’指出发后不能生还。"
            },
            {
              "start": 6,
              "end": 6,
              "content": "反：通‘返’，返回；强调一去不回的悲壮。"
            },
            {
              "start": 10,
              "end": 10,
              "content": "忽：辽阔迷茫的样子，形容原野无边。"
            },
            {
              "start": 12,
              "end": 15,
              "content": "路超远：道路遥远；超，遥远貌，强调征途漫长。"
            }
          ],
          "different_meanings": [
            {
              "start": 6,
              "end": 6,
              "old": "返回"
            },
            {
              "start": 6,
              "end": 6,
              "new": "反对"
            }
          ],
          "special_sentences": [
            {
              "start": 0,
              "end": 7,
              "content": "‘出不入兮往不反’为并列递进复句，通过重复强调有去无回的决绝，属楚辞典型悲壮句式。"
            }
          ]
        }
      ]
