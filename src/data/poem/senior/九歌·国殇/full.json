            }
          ],
          "translation": "手执吴地的戈啊披着犀牛皮铠甲，战车交错轮毂啊短兵器相拼杀。",
          "pinyin": "cāo wú gē xī bèi xī jiǎ ， chē cuò gū xī duǎn bīng jiē 。",
          "notes": [
            {
              "start": 0,
              "end": 1,
              "content": "操：拿着；吴戈：吴地所产的戈，象征精良兵器，代指先进武器装备。"
            },
            {
              "start": 3,
              "end": 4,
              "content": "被：通‘披’，穿在身上；犀甲：犀牛皮制成的铠甲，极坚韧，代指重甲。"
            },
            {
              "start": 8,
              "end": 9,
              "content": "错：交错；毂（gǔ）：车轮中心插轴处，‘车错毂’指战车近距离交战。"
            },
            {
              "start": 12,
              "end": 13,
              "content": "短兵：短兵器，如剑、匕首，指近身搏斗。"
            }
          ],
          "different_meanings": [
            {
              "start": 4,
              "end": 4,
              "old": "披，穿戴"
            },
            {
              "start": 4,
              "end": 4,
              "new": "被动介词，如‘被批评’"
            }
          ]
        }
      ]
    },
