            }
          ],
          "translation": "埋住战车的两个轮子啊绊住四匹战马，拿起玉槌啊敲击起响亮的战鼓。",
          "pinyin": "mái liǎng lún xī zhí sì mǎ ， yuán yù fú xī jī míng gǔ 。",
          "notes": [
            {
              "start": 0,
              "end": 0,
              "content": "霾（mái）：通‘埋’，埋没；指战车陷入泥泞或被掩埋。"
            },
            {
              "start": 4,
              "end": 4,
              "content": "絷（zhí）：绊住，拴住；絷四马即四匹战马被绊无法前行。"
            },
            {
              "start": 8,
              "end": 8,
              "content": "援：拿起，持；援玉枹指手持玉饰的鼓槌。"
            },
            {
              "start": 9,
              "end": 10,
              "content": "玉枹（fú）：饰以玉的鼓槌，象征庄严与指挥权。"
            },
            {
              "start": 12,
              "end": 12,
              "content": "击鸣鼓：敲响战鼓，古代作战用以指挥进退。"
            }
          ],
          "different_meanings": [
            {
              "start": 0,
              "end": 0,
              "old": "埋没"
            },
            {
              "start": 0,
              "end": 0,
              "new": "空气中悬浮颗粒物天气现象"
            }
          ]
        }
      ]
