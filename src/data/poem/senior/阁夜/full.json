            }
          ],
          "translation": "年底时节，昼夜交替催促着短暂的光影。",
          "pinyin": "suì mù yīn yáng cuī duǎn jǐng 。",
          "notes": [
            {
              "start": 0,
              "end": 1,
              "content": "岁暮：指一年将尽，也暗喻人生迟暮。"
            },
            {
              "start": 2,
              "end": 3,
              "content": "阴阳：此处指昼夜，因冬至后阳气渐生、阴气渐退，白昼变长。"
            },
            {
              "start": 6,
              "end": 7,
              "content": "短景：指冬季日影短，白昼时间少。‘景’通‘影’，非指风景。"
            }
          ],
          "different_meanings": [
            {
              "start": 7,
              "end": 7,
              "old": "日影，光阴"
            },
            {
              "start": 7,
              "end": 7,
              "new": "景色"
            }
          ]
        }
      ]
    },
