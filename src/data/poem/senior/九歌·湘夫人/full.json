          ],
          "translation": "秋风轻轻吹拂，洞庭湖上波浪起伏，树叶纷纷飘落。",
          "pinyin": "niǎo niǎo xī qiū fēng ， dòng tíng bō xī mù yè xià 。",
          "notes": [
            {
              "start": 0,
              "end": 1,
              "content": "袅袅：微风轻拂的样子，常用来渲染秋意与离愁。"
            },
            {
              "start": 11,
              "end": 12,
              "content": "木叶：指树叶，‘木’强调树的质感，‘叶’为落叶，是古典诗歌中的典型意象。"
            }
          ]
        }
      ]
