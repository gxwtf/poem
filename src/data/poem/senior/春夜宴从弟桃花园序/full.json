          "translation": "诸位贤弟才情出众，都像谢惠连一样；我作诗吟咏，却独自惭愧不如谢康乐。",
          "pinyin": "qún jì jùn xiù ， jiē wéi huì lián ； wú rén yǒng gē ， dú cán kāng lè 。",
          "notes": [
            {
              "start": 1,
              "end": 1,
              "content": "季：兄弟中最小的，称‘季’。古代兄弟排行‘伯、仲、叔、季’。此处指诸弟。"
            },
            {
              "start": 7,
              "end": 9,
              "content": "惠连：指南朝文学家谢惠连，谢灵运之族弟，才华早著。此处以谢惠连比诸弟。"
            },
            {
              "start": 17,
              "end": 19,
              "content": "康乐：指谢灵运，袭封康乐公，南朝著名山水诗人。李白自谦才不及谢灵运。"
            }
          ],
          "different_meanings": [
            {
              "start": 1,
              "end": 1,
              "old": "兄弟中最小的（排行）"
            },
            {
              "start": 1,
              "end": 1,
              "new": "季节中的第三个月或季节泛称"
            }
