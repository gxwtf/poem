          ],
          "translation": "何况温暖的春天用如烟的美景召唤我，大自然赋予我绚丽的文采。",
          "pinyin": "kuàng yáng chūn zhào wǒ yǐ yān jǐng ， dà kuài jiǎ wǒ yǐ wén zhāng 。",
          "notes": [
            {
              "start": 1,
              "end": 2,
              "content": "阳春：温暖的春天，特指春光明媚之时。阳，温暖；春，春季。"
            },
            {
              "start": 6,
              "end": 7,
              "content": "烟景：如烟般朦胧美丽的春景。烟，形容春雾缭绕、花木朦胧之貌。"
            },
            {
              "start": 10,
              "end": 10,
              "content": "大块：指大地、自然界。语出《庄子》：‘夫大块噫气，其名为风。’此处代指大自然。"
            },
            {
              "start": 14,
              "end": 15,
              "content": "文章：原指错杂的色彩与纹理，此处引申为大自然的美景。古义与今义不同。"
            }
          ],
          "different_meanings": [
            {
              "start": 14,
              "end": 15,
              "old": "自然美景（如花木纹理、山水风光）"
            },
            {
              "start": 14,
              "end": 15,
              "new": "文字作品"
            },
            {
              "start": 10,
              "end": 10,
              "old": "大地，自然界"
            },
            {
              "start": 10,
              "end": 10,
              "new": "大型物体或块状物"
            }
          ],
          "special_sentences": [
            {
              "start": 1,
              "end": 8,
              "content": "状语后置句，‘阳春召我以烟景’即‘阳春以烟景召我’，介宾结构‘以烟景’作状语后置。"
            },
            {
              "start": 10,
              "end": 16,
              "content": "状语后置句，‘大块假我以文章’即‘大块以文章假我’，‘以文章’为介宾短语作状语后置。"
            }
          ]
        },
