          ],
          "translation": "汉家天子看重美色，想得到绝代佳人，统治天下多年却始终找不到。",
          "pinyin": "hàn huáng zhòng sè sī qīng guó ， yù yǔ duō nián qiú bù dé 。",
          "notes": [
            {
              "start": 0,
              "end": 1,
              "content": "汉皇：借指唐玄宗，汉代无此称，乃借古讽今笔法。"
            },
            {
              "start": 2,
              "end": 3,
              "content": "重色：偏爱美色，暗示其治国失衡，为全诗批判起点。"
            },
            {
              "start": 5,
              "end": 6,
              "content": "倾国：指能使国家倾覆的绝色女子，典出《汉书》，非现代‘全国’之意。"
            },
            {
              "start": 8,
              "end": 9,
              "content": "御宇：统治天下。御，掌控；宇，天下疆域。"
            },
            {
              "start": 12,
              "end": 14,
              "content": "求不得：始终未能寻得，既是事实，也暗含佛教‘八苦’中的人生遗憾。"
            }
          ],
          "different_meanings": [
            {
              "start": 5,
              "end": 6,
              "old": "使国家倾覆的美人"
            },
            {
              "start": 5,
              "end": 6,
              "new": "全国范围的事件或力量"
            }
          ]
        }
      ]
