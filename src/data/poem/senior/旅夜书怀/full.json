          ],
          "translation": "微风吹拂着江岸上的细草，竖着高高桅杆的小船在夜里孤独地停泊着。",
          "pinyin": "xì cǎo wēi fēng àn ， wēi qiáng dú yè zhōu 。",
          "notes": [
            {
              "start": 6,
              "end": 6,
              "content": "危：高，此处形容桅杆高耸，非‘危险’之意。"
            },
            {
              "start": 7,
              "end": 7,
              "content": "樯：船上的桅杆，代指船只，‘危樯’凸显孤舟之渺小。"
            },
            {
              "start": 8,
              "end": 8,
              "content": "独：孤独，表现诗人漂泊无依的情感状态。"
            }
          ],
          "different_meanings": [
            {
              "start": 6,
              "end": 6,
              "old": "高"
            },
            {
              "start": 6,
              "end": 6,
              "new": "危险"
            }
          ]
        }
      ]
