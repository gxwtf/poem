          ],
          "translation": "人人都说江南美好，远行的人应该在江南终老。",
          "pinyin": "rén rén jìn shuō jiāng nán hǎo ， yóu rén zhǐ hé jiāng nán lǎo 。",
          "notes": [
            {
              "start": 2,
              "end": 2,
              "content": "尽：都，全部，表示普遍认同的语气。"
            },
            {
              "start": 11,
              "end": 11,
              "content": "合：应当，理应，表达一种人生选择的建议。"
            }
          ],
          "different_meanings": [
            {
              "start": 11,
              "end": 11,
              "old": "应当"
            },
            {
              "start": 11,
              "end": 11,
              "new": "合并、结合"
            }
          ]
        }
      ]
    },
