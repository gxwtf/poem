          ],
          "translation": "大铁椎，不知道是什么地方的人。北平人陈子灿到河南去看望哥哥，有机会看到他。",
          "pinyin": "dà tiě chuí ， bù zhī hé xǔ rén ， běi píng chén zǐ càn xǐng xiōng hé nán ， dé bèi guān yān 。",
          "notes": [
            {
              "start": 0,
              "end": 3,
              "content": "大铁椎：一种铁制重型兵器，形如短棒，用于近战击打。"
            },
            {
              "start": 6,
              "end": 7,
              "content": "何许：什么地方。许，处所，古文中常用‘何许人’表示籍贯或来历不明。"
            },
            {
              "start": 15,
              "end": 15,
              "content": "省：探望，特指探望尊长或亲属。此处指陈子灿前往探望兄长。"
            },
            {
              "start": 21,
              "end": 21,
              "content": "备：副词，表示‘详尽地’‘全面地’，非‘准备’之意。"
            },
            {
              "start": 23,
              "end": 23,
              "content": "焉：兼词，相当于‘于之’，指在那里，即河南，表示得以亲眼见到大铁椎其人。"
            }
          ],
          "different_meanings": [
            {
              "start": 6,
              "end": 7,
              "old": "地方"
            },
            {
              "start": 6,
              "end": 7,
              "new": "许可、许多"
            },
            {
              "start": 15,
              "end": 15,
              "old": "探望"
            },
            {
              "start": 15,
              "end": 15,
              "new": "节省、省份"
            }
          ],
          "special_sentences": [
            {
              "start": 4,
              "end": 9,
              "content": "‘不知何许人’为判断句省略形式，完整应为‘不知其为何许人也’，省略谓语与语气词。"
            }
          ]
        }
      ]
