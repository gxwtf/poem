          "translation": "能用拳头打裂砖石，力气惊人，却不因武艺而骄傲自大。",
          "pinyin": "néng yǐ quán liè zhuān shí ， lì jīng rén ， rán bù yǐ wǔ zì jīn 。",
          "notes": [
            {
              "start": 3,
              "end": 3,
              "content": "裂：使动用法，意为‘使……破裂’，即用拳头击碎砖石。"
            },
            {
              "start": 8,
              "end": 8,
              "content": "惊：使动用法，‘使……震惊’，形容其力量惊人。"
            },
            {
              "start": 15,
              "end": 16,
              "content": "自矜：自夸。‘自’为‘矜’的宾语，前置，属宾语前置结构。"
            }
          ],
          "different_meanings": [
            {
              "start": 15,
              "end": 16,
              "old": "自夸"
            },
            {
              "start": 15,
              "end": 16,
              "new": "现代汉语中已不常用，仅见于文言引用"
            }
          ],
          "special_sentences": [
