              "end": 9,
              "old": "仅仅现在、如今（文言常用）"
            },
            {
              "start": 8,
              "end": 9,
              "new": "现在、目前（现代汉语中‘只今’已不常用，多用‘如今’或‘现在’）"
            }
          ],
          "special_sentences": [
