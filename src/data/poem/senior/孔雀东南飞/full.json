          ],
          "translation": "孔雀向东南方向飞去，每飞五里就徘徊不前。",
          "pinyin": "kǒng què dōng nán fēi ， wǔ lǐ yī pái huái 。",
          "notes": [
            {
              "start": 8,
              "end": 9,
              "content": "五里：五里路。古人以里程表达空间距离，体现孔雀飞离时的不舍之情。"
            },
            {
              "start": 9,
              "end": 10,
              "content": "徘徊：来回走动，形容留恋不舍，非现代‘犹豫’之意。"
            }
          ],
          "different_meanings": [
            {
              "start": 9,
              "end": 10,
              "old": "来回走动，表达依恋"
            },
            {
              "start": 9,
              "end": 10,
              "new": "犹豫不决"
            }
          ]
        }
      ]
    },
