          "translation": "男子汉本就重视在战场上纵横驰骋。",
          "pinyin": "nán ér běn zì zhòng héng xíng 。",
          "notes": [
            {
              "start": 5,
              "end": 6,
              "content": "横行：在古文中指英勇驰骋、所向无敌，为褒义词，与现代贬义不同。"
            }
          ],
          "different_meanings": [
            {
              "start": 5,
              "end": 6,
              "old": "英勇驰骋，所向无敌"
            },
            {
              "start": 5,
              "end": 6,
              "new": "蛮横无理地行动"
            }
          ]
        }
