          ],
          "translation": "登上城楼高处远望荒凉旷野，海天之间忧愁的思绪无边无际。",
          "pinyin": "chéng shàng gāo lóu jiē dà huāng ， hǎi tiān chóu sī zhèng máng máng 。",
          "notes": [
            {
              "start": 5,
              "end": 6,
              "content": "大荒：荒远之地，指边远荒凉的地区，象征贬谪环境的孤寂与隔绝。"
            },
            {
              "start": 14,
              "end": 15,
              "content": "茫茫：形容海天无际，也比喻愁思的广阔深远，情景交融。"
            }
          ]
        }
      ]
