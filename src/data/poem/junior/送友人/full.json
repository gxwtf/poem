          ],
          "translation": "青翠的山峦横亘在外城北面，清澈的河水环绕着东城流淌。",
          "pinyin": "qīng shān héng běi guō ， bái shuǐ rào dōng chéng 。",
          "notes": [
            {
              "start": 4,
              "end": 4,
              "content": "郭：古代指外城，与‘城’相对，‘城’为内城，‘郭’为外城。"
            },
            {
              "start": 8,
              "end": 9,
              "content": "白水：清澈的河水，此处泛指明净的水流，象征离别的纯净情感。"
            }
          ],
          "different_meanings": [
            {
              "start": 4,
              "end": 4,
              "old": "外城"
            },
            {
              "start": 4,
              "end": 4,
              "new": "姓氏或泛指城市"
            }
          ]
        }
      ]
