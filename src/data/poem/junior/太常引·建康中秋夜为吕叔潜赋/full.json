            }
          ],
          "translation": "我举杯问月宫中的嫦娥：满头白发渐渐侵袭，这欺人的岁月叫我如何是好？",
          "pinyin": "bǎ jiǔ wèn héng é ： bèi bái fà ， qī rén nài hé ？",
          "notes": [
            {
              "start": 0,
              "end": 1,
              "content": "把酒：手持酒杯，'把'意为持、执，表现诗人对月豪饮的洒脱姿态。"
            },
            {
              "start": 3,
              "end": 4,
              "content": "姮娥：即嫦娥，传说中月宫仙子，此处借指月亮，含典故色彩。"
            },
            {
              "start": 6,
              "end": 8,
              "content": "被白发：眼见白发丛生，'被'非被动义，而是任凭、无奈面对的意思，表达年华老去之悲。"
            },
            {
              "start": 12,
              "end": 14,
              "content": "奈何：怎么办，固定疑问结构，强化对岁月无情的无奈与愤懑。"
            }
          ],
          "special_sentences": [
            {
              "start": 12,
              "end": 14,
              "content": "'奈何'为宾语前置结构，正常语序应为'何奈'，即'如何是好'，属文言固定疑问句式。"
            }
          ]
        }
      ]
