              "end": 4,
              "new": "荣耀"
            }
          ],
          "special_sentences": [
            {
              "start": 7,
              "end": 8,
              "content": "将以遗所思：省略句，‘以’后省略宾语‘之’（指花），完整为‘将以（之）遗所思’。"
            }
          ]
        }
      ]
