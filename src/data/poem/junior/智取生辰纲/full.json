          "translation": "杨志拿着藤条，催促说：“快走！这里正是强盗出没的地方，不能久留！”",
          "pinyin": "yáng zhì shǒu chí téng tiáo ， cuī cù dào ：“ kuài zǒu ！ cǐ chù zhèng shì qiáng rén chū mò zhī dì ， bù kě jiǔ liú ！”",
          "notes": [
            {
              "start": 4,
              "end": 5,
              "content": "藤条：用藤蔓制成的长条，常作鞭打或驱赶工具。"
            },
            {
              "start": 19,
              "end": 20,
              "content": "强人：古指强盗、贼寇，与今义‘强者’不同。"
            }
          ],
          "different_meanings": [
            {
              "start": 19,
              "end": 20,
              "old": "强盗"
            },
            {
              "start": 19,
              "end": 20,
              "new": "有能力的人"
            }
          ],
          "special_sentences": [
            {
              "start": 15,
              "end": 25,
              "content": "判断句，‘此处正是……之地’为典型的文言判断结构。"
            }
          ]
        }
      ]
