          ],
          "translation": "轻便的小船和短桨游西湖真美好，清澈的水蜿蜒流淌。",
          "pinyin": "qīng zhōu duǎn zhào xī hú hǎo ， lǜ shuǐ wēi yǐ 。",
          "notes": [
            {
              "start": 3,
              "end": 3,
              "content": "棹：读作zhào，指船桨，此处代指小船。短棹，即小船。"
            },
            {
              "start": 10,
              "end": 11,
              "content": "逶迤：形容水流曲折绵延不断的样子。"
            }
          ]
        }
      ]
