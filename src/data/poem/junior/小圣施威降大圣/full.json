          "translation": "那大圣变成一条鱼，潜入水中，早被二郎神变作一只鱼鹰，盯在水面上。",
          "pinyin": "nà dà shèng biàn yú ér ， cuì rù shuǐ zhōng ， zǎo bèi èr láng yé ye biàn zuò yī zhī yú yīng ér ， dìng zài shuǐ miàn shàng 。",
          "notes": [
            {
              "start": 7,
              "end": 7,
              "content": "淬：原指金属急速冷却，此处引申为猛地扎入，形容动作迅猛。"
            },
            {
              "start": 15,
              "end": 16,
              "content": "二郎爷爷：即二郎神，民间对神灵的尊称，重复‘爷’表敬意。"
            },
            {
              "start": 19,
              "end": 19,
              "content": "变作：文言动词结构，相当于‘变成’，‘作’意为‘作为、成为’。"
            },
            {
              "start": 25,
              "end": 25,
              "content": "钉：比喻用法，形容鱼鹰紧盯水面，如钉子般固定，突出其专注与压迫感。"
            }
          ],
          "different_meanings": [
            {
              "start": 7,
              "end": 7,
              "old": "猛地投入、扎入"
            },
            {
              "start": 7,
              "end": 7,
              "new": "金属热处理工艺"
            }
          ],
          "special_sentences": [
            {
              "start": 25,
              "end": 25,
              "content": "‘钉在水面’为意会被动句，隐含‘被鱼鹰牢牢盯住’之意，属动作结果补语结构。"
            }
          ]
