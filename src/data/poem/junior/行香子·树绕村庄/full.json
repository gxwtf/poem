          "translation": "绿树环绕着村庄，池塘里春水盈盈。",
          "pinyin": "shù rào cūn zhuāng ， shuǐ mǎn bēi táng 。",
          "notes": [
            {
              "start": 7,
              "end": 7,
              "content": "陂（bēi）：池塘，古代常用词，与‘坡’（pō）音义不同。"
            }
          ],
          "different_meanings": [
            {
              "start": 7,
              "end": 7,
              "old": "池塘（读bēi）"
            },
            {
              "start": 7,
              "end": 7,
              "new": "山坡（读pō）"
            }
          ]
        }
