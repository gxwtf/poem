          ],
          "translation": "鸟儿飞落绿草丛中的秦代宫苑，正值黄昏，蝉在黄叶间鸣叫，如同汉代宫殿的秋天。",
          "pinyin": "niǎo xià lǜ wú qín yuàn xī ， chán míng huáng yè hàn gōng qiū 。",
          "notes": [
            {
              "start": 2,
              "end": 3,
              "content": "绿芜：丛生的绿色杂草，象征荒凉与衰败。"
            },
            {
              "start": 4,
              "end": 5,
              "content": "秦苑：秦代皇家园林，咸阳曾为秦都，今已荒废。"
            },
            {
              "start": 12,
              "end": 13,
              "content": "汉宫：汉代宫殿，代指昔日繁华，与‘秋’构成衰败意象。"
            }
          ],
          "special_sentences": [
            {
              "start": 0,
              "end": 7,
              "content": "‘鸟下绿芜秦苑夕’为意象并列句，无动词连接，通过名词叠加营造画面感，属诗歌特殊句式。"
            },
            {
              "start": 8,
              "end": 15,
              "content": "‘蝉鸣黄叶汉宫秋’为意象并列与视听结合句式，黄叶、蝉鸣、汉宫、秋共同构建衰败意境。"
            }
          ]
        }
