            }
          ],
          "translation": "乌云横亘在秦岭之上，家乡在哪里？大雪堵塞蓝关，连马也不肯前行。",
          "pinyin": "yún héng qín lǐng jiā hé zài ？ xuě yōng lán guān mǎ bù qián 。",
          "notes": [
            {
              "start": 2,
              "end": 3,
              "content": "秦岭：山脉名，长安以南，蓝关所在。横亘险阻，象征前途未卜。"
            },
            {
              "start": 5,
              "end": 6,
              "content": "何在：在哪里。疑问代词‘何’作宾语前置。"
            },
            {
              "start": 9,
              "end": 9,
              "content": "拥：堵塞、围堵，形容大雪堆积难行。非‘拥有’义。"
            },
            {
              "start": 10,
              "end": 11,
              "content": "蓝关：即蓝田关，在今陕西蓝田县东南，为长安通往南方的要道。"
            },
            {
              "start": 14,
              "end": 14,
              "content": "不前：不肯前进。‘前’为动词，向前行进。"
            }
          ],
          "different_meanings": [
            {
              "start": 9,
              "end": 9,
              "old": "堵塞、围堵"
            },
            {
              "start": 9,
              "end": 9,
              "new": "拥有、占有"
            },
            {
              "start": 14,
              "end": 14,
              "old": "向前走（动词）"
            },
            {
              "start": 14,
              "end": 14,
              "new": "前面（名词）"
            }
          ],
          "special_sentences": [
