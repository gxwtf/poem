            }
          ],
          "translation": "早晨呈上一封奏章到朝廷，傍晚就被贬到八千里外的潮州。",
          "pinyin": "yī fēng zhāo zòu jiǔ chóng tiān ， xī biǎn cháo zhōu lù bā qiān 。",
          "notes": [
            {
              "start": 0,
              "end": 1,
              "content": "一封：指韩愈上奏的《论佛骨表》。封，量词，用于书信、奏章。"
            },
            {
              "start": 2,
              "end": 3,
              "content": "朝奏：早晨向皇帝上奏。朝，早晨；奏，进呈。"
            },
            {
              "start": 4,
              "end": 6,
              "content": "九重天：指皇帝居住的深宫，代指朝廷。九重，极言宫禁之深。"
            },
            {
              "start": 8,
              "end": 8,
              "content": "夕：傍晚，与‘朝’形成时间对照，极言贬谪之速。"
            },
            {
              "start": 9,
              "end": 9,
              "content": "贬：降职并流放。此处指韩愈因谏迎佛骨被贬为潮州刺史。"
            },
            {
              "start": 13,
              "end": 15,
              "content": "路八千：形容路途遥远。八千，虚指，极言距离之远。"
            }
          ]
        }
      ]
    },
