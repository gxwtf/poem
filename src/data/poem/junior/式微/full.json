          ],
          "translation": "天黑了啊天黑了，为什么还不回家？",
          "pinyin": "shì wēi shì wēi ， hú bù guī ？",
          "notes": [
            {
              "start": 0,
              "end": 1,
              "content": "式微：天色昏暗，比喻劳役艰辛而不得归。‘式’为发语词，无实义；‘微’指昏暗。"
            },
            {
              "start": 5,
              "end": 5,
              "content": "胡：为什么，疑问代词，用于句首表反问。"
            },
            {
              "start": 0,
              "end": 1,
              "content": "式微：天将黑，引申为国家衰微。式，发语词；微，昏暗、衰落。"
            },
            {
              "start": 2,
              "end": 3,
              "content": "式微：同上，重章叠句，强调时局衰败或天色已晚。"
            },
            {
              "start": 5,
              "end": 5,
              "content": "胡：为何，为什么。古汉语中常用作疑问副词。"
            }
          ],
          "different_meanings": [
            {
              "start": 5,
              "end": 5,
              "old": "为什么"
            },
            {
              "start": 5,
              "end": 5,
              "new": "姓氏或北方民族泛称"
            },
            {
              "start": 5,
              "end": 5,
              "old": "为什么"
            },
            {
              "start": 5,
              "end": 5,
              "new": "胡乱、胡人（无‘为什么’义）"
            }
          ]
        }
      ]
    },
