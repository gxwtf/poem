              "start": 0,
              "end": 3,
              "content": "幸甚至哉：乐府诗常用结尾套语，表示庆幸之至，表达感慨之情。"
            },
            {
              "start": 5,
              "end": 8,
              "content": "歌以咏志：用诗歌来抒发志向。‘以’表示目的，相当于‘用来’。"
            }
          ],
          "special_sentences": [
