          ],
          "translation": "山中的景色使鸟儿的性情愉悦，潭水的倒影让人心中空明清净。",
          "pinyin": "shān guāng yuè niǎo xìng ， tán yǐng kōng rén xīn 。",
          "notes": [
            {
              "start": 1,
              "end": 2,
              "content": "山光：山间日光或山色，描绘自然美景，给人以明丽之感。"
            },
            {
              "start": 2,
              "end": 4,
              "content": "悦鸟性：使鸟的本性感到愉悦。‘悦’为使动用法，意为‘使……快乐’。"
            },
            {
              "start": 7,
              "end": 8,
              "content": "潭影：水潭中的倒影，清冷空灵，映照人心。"
            },
            {
              "start": 8,
              "end": 11,
              "content": "空人心：使人心空明清净。‘空’为使动用法，消除杂念，达到禅悟境界。"
            }
          ],
          "special_sentences": [
            {
              "start": 2,
              "end": 4,
              "content": "‘悦鸟性’为使动用法，意为‘使鸟的本性愉悦’。"
            },
            {
              "start": 8,
              "end": 11,
              "content": "‘空人心’为使动用法，意为‘使人心空明清净’。"
            }
          ]
        }
      ]
