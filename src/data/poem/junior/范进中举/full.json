          "translation": "老太太吓慌了，急忙端来几口开水灌进他嘴里。",
          "pinyin": "lǎo tài tai huāng le ， huāng jiāng jǐ kǒu kāi shuǐ guàn le guò lái 。",
          "notes": [
            {
              "start": 7,
              "end": 7,
              "content": "将：介词，相当于‘拿’‘用’，引出动作所用之物，文言残留用法。"
            }
          ],
          "different_meanings": [
            {
              "start": 7,
              "end": 7,
              "old": "拿、用（介词）"
            },
            {
              "start": 7,
              "end": 7,
              "new": "将要（副词）"
            }
          ],
          "special_sentences": [
            {
              "start": 7,
              "end": 16,
              "content": "‘慌将几口开水灌了过来’为文言介词结构，‘将’引出受事宾语，相当于‘把’字句前身。"
            }
          ]
