          ],
          "translation": "宋国国君派人向丁家询问这件事，丁家回答说：‘是得到了一个人的劳力，并不是从井里挖出一个人来啊。’",
          "pinyin": "sòng jūn lìng rén wèn zhī yú dīng shì ， dīng shì duì yuē ： ‘ dé yī rén zhī shǐ ， fēi dé yī rén yú jǐng zhōng yě 。’",
          "notes": [
            {
              "start": 2,
              "end": 9,
              "content": "令……问之于丁氏：命令派人向丁氏询问，‘于丁氏’为状语后置。"
            },
            {
              "start": 12,
              "end": 14,
              "content": "对曰：回答说，‘对’专指在上级或提问者面前回应。"
            },
            {
              "start": 16,
              "end": 21,
              "content": "得一人之使：得到一个人的劳力使用，‘之’为结构助词，连接定语与中心词。"
            },
            {
              "start": 22,
              "end": 30,
              "content": "非得一人于井中也：不是从井里挖出一个人，‘非……也’构成否定判断句。"
            }
          ],
          "different_meanings": [
            {
              "start": 20,
              "end": 20,
              "old": "使用、役使"
            },
            {
              "start": 20,
              "end": 20,
              "new": "派遣、让"
            }
          ],
          "special_sentences": [
            {
              "start": 2,
              "end": 9,
              "content": "‘问之于丁氏’为状语后置句，正常语序应为‘于丁氏问之’。"
            },
            {
              "start": 16,
              "end": 21,
              "content": "‘一人之使’为定语后置结构，‘之’为标志，意为‘一人的劳力’。"
            },
            {
              "start": 22,
              "end": 30,
              "content": "‘非得一人于井中也’为否定判断句，以‘非……也’构成。"
            }
          ]
        },
